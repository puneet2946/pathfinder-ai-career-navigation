# GEMINI_API_KEY: Highly secure development & production API Key for accessing the Gemini model endpoints.
# This variable should be configured securely via environment configurations or secrets managers.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The full canonical hosting address of the deployed web application server.
# Used for local testing, self-referential canonical links, and remote API client configurations.
APP_URL="YOUR_APP_URL"
